{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1" },
    "outcomeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "policyPath": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?:(?!\\.{1,2}(?:\\/|$))[A-Za-z0-9._-]+\\/)*(?!\\.{1,2}$)[A-Za-z0-9._-]+$"
    },
    "policyCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "policyDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "subjectCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "inputs": {
      "type": "object",
      "properties": {
        "artifactDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "runtimeDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "checkDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "checkMode": { "type": "string", "enum": ["100644", "100755"] }
      },
      "required": [
        "artifactDigest",
        "runtimeDigest",
        "checkDigest",
        "checkMode"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "outcomeId",
    "policyPath",
    "policyCommit",
    "policyDigest",
    "subjectCommit",
    "inputs"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/davidahma/mill/main/schemas/maintained-outcome-request.schema.json",
  "title": "MaintainedOutcomeRequest"
}
