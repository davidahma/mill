{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1" },
    "changeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "measurements": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "kind": {
            "type": "string",
            "enum": ["preparation", "run", "native"]
          },
          "evidenceDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "candidateCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "runId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "sessionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "source": { "type": "string", "enum": ["measured", "unavailable"] },
          "inputTokens": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "outputTokens": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "cacheInputTokens": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "evidenceDigest",
          "candidateCommit",
          "source",
          "inputTokens",
          "outputTokens",
          "cacheInputTokens"
        ],
        "additionalProperties": false
      }
    },
    "effort": {
      "type": "object",
      "properties": {
        "preparationMinutes": {
          "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
        },
        "reviewMinutes": {
          "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
        },
        "repairMinutes": {
          "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
        }
      },
      "required": ["preparationMinutes", "reviewMinutes", "repairMinutes"],
      "additionalProperties": false
    },
    "hostedRequests": {
      "anyOf": [
        { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        { "type": "null" }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "changeId",
    "measurements",
    "effort",
    "hostedRequests"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/davidahmann/mill/schemas/change-evidence.schema.json",
  "title": "ChangeEvidence"
}
